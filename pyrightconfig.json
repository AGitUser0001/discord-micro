{
  "venvPath": ".",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": "examples/bot",
      "extraPaths": [
        "src",
        "examples/bot/src"
      ]
    },
    {
      "root": "examples/apache_age",
      "extraPaths": [
        "src",
        "examples/apache_age/src"
      ]
    },
    {
      "root": ".",
      "extraPaths": [
        "src"
      ]
    }
  ],
  "exclude": [
    ".ruff_cache",
    "**/__pycache__",
    "**/.*",
    ".venv",
    "**/node_modules"
  ]
}

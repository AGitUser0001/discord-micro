{
  "venvPath": ".",
  "venv": ".venv",
  "executionEnvironments": [
    {
      "root": "examples/application",
      "extraPaths": ["src", "examples/apache_age/src"]
    },
    {
      "root": "examples/apache_age",
      "extraPaths": ["src", "examples/apache_age/src"]
    },
    {
      "root": "examples/jetstream_nats",
      "extraPaths": ["src", "examples/jetstream_nats/src"]
    },
    {
      "root": ".",
      "extraPaths": ["src"]
    }
  ],
  "exclude": [
    ".ruff_cache",
    "**/__pycache__",
    "**/.*",
    ".venv",
    "**/node_modules"
  ]
}

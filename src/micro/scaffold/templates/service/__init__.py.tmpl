"""The ${name} service."""

from micro.discord.interactions import Commands, Interaction
from micro.discord.ui import Draft
from micro.service import Service

service = Service("${name}")
commands = Commands(service)


@commands.slash("${command}", description="${name}")
async def ${function}(ctx: Interaction) -> None:
  await ctx.respond(Draft("${name} is running.", ephemeral=True))
